# Copy to .env. Everything is optional: with no key the app runs in replay mode.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5            # answers; evals use gpt-5.4-mini
# FOLLOW_UP_MODEL=gpt-5.4-mini    # suggested next questions
# CARE_AGENT_MODE=replay          # force "replay" or "live"; default is live when a key is set
# CARE_LOG_CONTENT=1              # log questions and SQL (they can name people); off by default
# CARE_DB=/path/to/care_data.db   # default: sources/care_data.db
